views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("Blog/source/_draft")
    order:
      - file.name
      - categories
      - category
      - file.tags
      - date
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 268
      file.tags: 400
      note.date: 190
